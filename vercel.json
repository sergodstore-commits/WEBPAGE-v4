{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:packages && npm run build --workspace=@sergod/web",
  "installCommand": "npm ci",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://sergod-store-api-v4.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    }
  ]
}
