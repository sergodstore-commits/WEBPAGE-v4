{
  "manifest_version": 3,
  "name": "SERGOD STORE · Resultados de Konami",
  "version": "1.1.0",
  "description": "Busca los torneos finalizados de SERGOD STORE en Konami y entrega todos sus resultados al panel cuando pulsas Actualizar.",
  "key": "",
  "host_permissions": ["https://shp.cardgame-network.konami.net/mt/home/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://shp.cardgame-network.konami.net/mt/home/*"],
      "js": ["reader.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "externally_connectable": {
    "matches": ["https://www.sergodstore.cl/*"]
  }
}
