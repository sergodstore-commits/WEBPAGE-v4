# Local: no se requieren servicios externos. Nunca subir .env.local.
APP_URL=http://localhost:3000
# Vacío utiliza PostgreSQL embebido persistente en .data/postgres (solo desarrollo).
DATABASE_URL=
DATABASE_SSL=true
# Si tu conexión PostgreSQL exige CA propia, certificado PEM (\n admitido).
DATABASE_SSL_CA=
LOCAL_DATA_DIR=.data
# Aplicar automáticamente migraciones solo en un entorno de desarrollo remoto.
AUTO_MIGRATE=false
# En producción: Supabase Storage (bucket público de imágenes).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images
# Proveedor Flow: sandbox o production. Se necesita URL HTTPS pública para callbacks.
FLOW_ENV=sandbox
FLOW_API_KEY=
FLOW_SECRET_KEY=
# Correo SMTP; sin configurar, outbox local privado en desarrollo.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Secreto independiente para ejecutar el mantenimiento desde un cron.
CRON_SECRET=
# Solo para script de creación de administrador, no para navegador.
ADMIN_EMAIL=
ADMIN_PASSWORD=
