# SERGOD STORE WEB V1 — CONFIGURATION CONTRACT
# Never commit real secrets. Copy to .env locally and fill only in the appropriate environment.

# APPLICATION
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
API_PUBLIC_URL=http://127.0.0.1:3000
WEB_APP_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# PUBLIC FRONTEND — safe to expose in browser only when the provider defines them as public
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_PUBLIC_URL=http://127.0.0.1:3000

# DATABASE / SUPABASE — server only unless explicitly marked public above
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
CATALOG_ASSET_BUCKET=catalog-assets
INBOX_ENCRYPTION_KEY_BASE64=

# TECHNICAL WORKERS
WORKER_LEASE_MS=
WORKER_BATCH_SIZE=
WORKER_POLL_MS=
WORKER_MAX_ATTEMPTS=
WORKER_BASE_BACKOFF_MS=
CONTACT_CHANGE_TTL_MS=

# PUBLIC CATALOG RATE LIMIT
CATALOG_PUBLIC_RATE_LIMIT_MAX_REQUESTS=120
CATALOG_PUBLIC_RATE_LIMIT_WINDOW_MS=60000

# FLOW — server only; exact sandbox/production values are supplied during final external acceptance
FLOW_API_KEY=
FLOW_SECRET_KEY=
FLOW_BASE_URL=

# WEBPAY PLUS / TRANSBANK — server only
WEBPAY_COMMERCE_CODE=
WEBPAY_API_KEY=
WEBPAY_ENVIRONMENT=integration

# TRANSACTIONAL EMAIL — provider is selected/verified during the Notifications stage
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# ADMIN ACCEPTANCE — never persist these values in Git; intended only as process variables when needed
SERGOD_ADMIN_EMAIL=
SERGOD_ADMIN_PASSWORD=
