    "04-remote-e2e-hardening": {
      "docs": [
        "03-REGLAS-DE-NEGOCIO.md",
        "06-UX-Y-PRESENTATION.md",
        "07-PRUEBAS-Y-CALIDAD.md",
        "09-SERVICIOS-EXTERNOS-Y-SECRETOS.md"
