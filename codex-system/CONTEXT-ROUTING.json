      ],
      "searchRoots": ["apps", "packages", "tests", "scripts", "supabase"],
      "targetedGates": [
        "npm run test:unit",
        "npm run test:application",
        "npm run test:contract",
        "npm run test:web",
        "npm run test:integration:local",
        "npm run build",
        "npm run delivery:audit"
      ]
    },
    "02-external-providers": {
      "docs": [
        "07-PRUEBAS-Y-CALIDAD.md",
        "09-SERVICIOS-EXTERNOS-Y-SECRETOS.md",
